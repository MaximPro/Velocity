---
/**
 * Footer Component
 * BMAD-CORE: Site footer with links and info
 */
import { SITE_CONFIG } from '@/core/config/site.config';
---

<footer class="border-t border-gray-200 bg-gray-50">
  <div class="container">
    <div class="py-12">
      <div class="grid grid-cols-1 gap-8 md:grid-cols-3">
        <!-- Brand -->
        <div>
          <div class="flex items-center space-x-2">
            <svg class="h-6 w-6 text-primary-600" fill="currentColor" viewBox="0 0 24 24">
              <path d="M13 10V3L4 14h7v7l9-11h-7z"/>
            </svg>
            <span class="text-lg font-bold text-gray-900">{SITE_CONFIG.name}</span>
          </div>
          <p class="mt-4 text-sm text-gray-600">
            {SITE_CONFIG.description}
          </p>
        </div>

        <!-- Links -->
        <div>
          <h3 class="text-sm font-semibold text-gray-900">Quick Links</h3>
          <ul class="mt-4 space-y-2">
            {SITE_CONFIG.navigation.main.map((item) => (
              <li>
                <a href={item.href} class="text-sm text-gray-600 hover:text-primary-600">
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
        </div>

        <!-- Social -->
        <div>
          <h3 class="text-sm font-semibold text-gray-900">Connect</h3>
          <div class="mt-4 flex space-x-4">
            {SITE_CONFIG.social.github && (
              <a
                href={SITE_CONFIG.social.github}
                target="_blank"
                rel="noopener noreferrer"
                class="text-gray-600 hover:text-primary-600"
                aria-label="GitHub"
              >
                <svg class="h-6 w-6" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
                </svg>
              </a>
            )}
          </div>
        </div>
      </div>

      <!-- Copyright -->
      <div class="mt-8 border-t border-gray-200 pt-8">
        <p class="text-center text-sm text-gray-600">
          © {new Date().getFullYear()} {SITE_CONFIG.author}. Built with Astro & BMAD-METHOD.
        </p>
      </div>
    </div>
  </div>
</footer>
