---
/**
 * Feature Card Component
 * BMAD-CORE: Feature showcase card
 */
interface Props {
  title: string;
  description: string;
  icon?: string;
}

const { title, description, icon = '⚡' } = Astro.props;
---

<div class="relative rounded-lg border border-gray-200 bg-white p-6 shadow-sm transition-all hover:shadow-md">
  <div class="mb-4 flex h-12 w-12 items-center justify-center rounded-lg bg-primary-100 text-2xl">
    {icon}
  </div>
  <h3 class="mb-2 text-lg font-semibold text-gray-900">{title}</h3>
  <p class="text-gray-600">{description}</p>
</div>
