---
/**
 * Card Component
 * BMAD-CORE: Reusable card component
 */
interface Props {
  title?: string;
  href?: string;
  class?: string;
}

const { title, href, class: className } = Astro.props;
const Tag = href ? 'a' : 'div';
---

<Tag
  href={href}
  class:list={[
    'block rounded-lg border border-gray-200 bg-white p-6 shadow-sm transition-shadow hover:shadow-md',
    href && 'hover:border-primary-300',
    className,
  ]}
>
  {title && (
    <h3 class="mb-4 text-xl font-semibold text-gray-900">{title}</h3>
  )}
  <slot />
</Tag>
